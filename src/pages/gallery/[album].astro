---
export const prerender = false;

import { randomUUID } from "node:crypto";
import fs from "node:fs/promises";
import path from "node:path";
import { Icon } from "astro-icon/components";
import PhotoCard from "@/components/pages/gallery/PhotoCard.astro";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import { assertSameOrigin, getCurrentUser } from "@/lib/server/auth";
import { query } from "@/lib/server/db";

const slug = Astro.params.album || "";
const user = await getCurrentUser(Astro.cookies);
const uploadRoot =
	process.env.GALLERY_UPLOAD_DIR || "/var/www/guamian/uploads/gallery";
let notice = "";
let error = "";
let album = (
	await query<{
		id: string;
		slug: string;
		name: string;
		description: string;
		location: string;
		album_date: string | null;
		tags: string;
	}>(
		"SELECT id::text, slug, name, description, location, album_date::text, tags FROM gallery_albums WHERE slug = $1",
		[slug],
	)
).rows[0];
if (!album) return new Response("相册不存在", { status: 404 });

if (Astro.request.method === "POST") {
	try {
		assertSameOrigin(Astro.request);
		if (!user)
			return Astro.redirect(
				`/login/?returnTo=${encodeURIComponent(Astro.url.pathname)}`,
			);
		const form = await Astro.request.formData();
		const action = String(form.get("action") || "");
		if (action === "update") {
			await query(
				"UPDATE gallery_albums SET name = $1, description = $2, location = $3, album_date = NULLIF($4, '')::date, tags = $5, updated_at = NOW() WHERE id = $6",
				[
					String(form.get("name") || "")
						.trim()
						.slice(0, 100),
					String(form.get("description") || "").slice(0, 500),
					String(form.get("location") || "").slice(0, 120),
					String(form.get("date") || ""),
					String(form.get("tags") || "").slice(0, 500),
					album.id,
				],
			);
			notice = "相册资料已更新";
		} else if (action === "upload") {
			const files = form
				.getAll("photos")
				.filter((item): item is File => item instanceof File && item.size > 0);
			if (!files.length) throw new Error("请选择图片");
			await fs.mkdir(uploadRoot, { recursive: true });
			for (const file of files.slice(0, 20)) {
				if (
					!/^image\/(jpeg|png|webp|gif|avif)$/i.test(file.type) ||
					file.size > 8 * 1024 * 1024
				)
					throw new Error("仅支持 JPG、PNG、WebP、GIF、AVIF，单张不超过 8MB");
				const id = randomUUID();
				await fs.writeFile(
					path.join(uploadRoot, id),
					Buffer.from(await file.arrayBuffer()),
					{ flag: "wx" },
				);
				await query(
					"INSERT INTO gallery_photos (id, album_id, uploaded_by, file_name, content_type, file_size) VALUES ($1, $2, $3, $4, $5, $6)",
					[
						id,
						album.id,
						user.id,
						file.name.slice(0, 255),
						file.type,
						file.size,
					],
				);
			}
			notice = `成功上传 ${files.length} 张图片`;
		} else if (action === "delete-photo") {
			const photoId = String(form.get("photoId") || "");
			await query(
				"DELETE FROM gallery_photos WHERE id = $1 AND album_id = $2",
				[photoId, album.id],
			);
			await fs.rm(path.join(uploadRoot, photoId), { force: true });
			notice = "图片已删除";
		}
		album = (
			await query<{
				id: string;
				slug: string;
				name: string;
				description: string;
				location: string;
				album_date: string | null;
				tags: string;
			}>(
				"SELECT id::text, slug, name, description, location, album_date::text, tags FROM gallery_albums WHERE id = $1",
				[album.id],
			)
		).rows[0];
	} catch (cause) {
		error = cause instanceof Error ? cause.message : "操作失败";
	}
}
const photos = await query<{
	id: string;
	file_name: string;
	username: string | null;
	created_at: Date;
}>(
	"SELECT p.id::text, p.file_name, u.username, p.created_at FROM gallery_photos p LEFT JOIN users u ON u.id = p.uploaded_by WHERE p.album_id = $1 ORDER BY p.created_at DESC",
	[album.id],
);
---

<MainGridLayout title={album.name} description={album.description}>
	<section class="card-base community-card"><a href="/gallery/" class="community-author-link">← 返回相册</a><h1 class="text-3xl font-bold mt-3">{album.name}</h1><p class="community-muted">{album.description}</p><p class="community-meta mt-2">{album.album_date || ""} {album.location ? `· ${album.location}` : ""} · {photos.rows.length} 张图片</p>{notice && <p class="community-alert mt-4">{notice}</p>}{error && <p class="community-alert error mt-4">{error}</p>}</section>
	{user && <section class="card-base community-card"><div class="community-grid"><form method="post" enctype="multipart/form-data" class="community-form"><input type="hidden" name="action" value="upload"/><h3 class="community-section-title">上传图片</h3><input type="file" name="photos" accept="image/jpeg,image/png,image/webp,image/gif,image/avif" multiple required/><button class="community-button primary">上传所选图片</button></form><form method="post" class="community-form"><input type="hidden" name="action" value="update"/><h3 class="community-section-title">修改相册资料</h3><label>名称<input name="name" value={album.name} required/></label><label>描述<input name="description" value={album.description}/></label><label>地点<input name="location" value={album.location}/></label><label>日期<input type="date" name="date" value={album.album_date || ""}/></label><label>标签<input name="tags" value={album.tags}/></label><button class="community-button">保存资料</button></form></div></section>}
	<section class="card-base community-card">{photos.rows.length ? <div class="gallery-masonry" style="column-count:2;column-gap:.75rem">{photos.rows.map((photo) => <div class="break-inside-avoid mb-3"><PhotoCard src={`/api/gallery/photos/${photo.id}`} albumId={album.slug} alt={photo.file_name}/>{user && <form method="post" onsubmit="return confirm('确定删除这张图片吗？')"><input type="hidden" name="action" value="delete-photo"/><input type="hidden" name="photoId" value={photo.id}/><button class="community-button">删除图片</button></form>}</div>)}</div> : <div class="community-muted py-12 text-center"><Icon is:inline name="material-symbols:photo-library" class="text-5xl"/><p>还没有图片</p></div>}</section>
</MainGridLayout>
