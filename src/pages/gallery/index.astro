---
export const prerender = false;

import { randomUUID } from "node:crypto";
import { Icon } from "astro-icon/components";
import AlbumCard from "@/components/pages/gallery/AlbumCard.astro";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import { assertSameOrigin, getCurrentUser } from "@/lib/server/auth";
import { query } from "@/lib/server/db";

const user = await getCurrentUser(Astro.cookies);
let notice = "";
let error = "";
if (Astro.request.method === "POST") {
	try {
		assertSameOrigin(Astro.request);
		if (!user)
			return Astro.redirect(
				`/login/?returnTo=${encodeURIComponent("/gallery/")}`,
			);
		const form = await Astro.request.formData();
		const action = String(form.get("action") || "");
		if (action === "create") {
			const name = String(form.get("name") || "")
				.trim()
				.slice(0, 100);
			const slug = String(form.get("slug") || "")
				.trim()
				.toLowerCase()
				.replace(/[^a-z0-9-]/g, "-")
				.replace(/-+/g, "-")
				.replace(/^-|-$/g, "")
				.slice(0, 80);
			if (!name || !slug) throw new Error("请填写相册名称和英文地址");
			await query(
				"INSERT INTO gallery_albums (id, slug, name, description, location, album_date, tags, created_by) VALUES ($1, $2, $3, $4, $5, NULLIF($6, '')::date, $7, $8)",
				[
					randomUUID(),
					slug,
					name,
					String(form.get("description") || "").slice(0, 500),
					String(form.get("location") || "").slice(0, 120),
					String(form.get("date") || ""),
					String(form.get("tags") || "").slice(0, 500),
					user.id,
				],
			);
			notice = "相册已创建";
		} else if (action === "delete") {
			await query("DELETE FROM gallery_albums WHERE id = $1", [
				String(form.get("albumId") || ""),
			]);
			notice = "相册已删除";
		}
	} catch (cause) {
		error = cause instanceof Error ? cause.message : "操作失败";
	}
}

const albums = await query<{
	id: string;
	slug: string;
	name: string;
	description: string;
	location: string;
	album_date: string | null;
	tags: string;
	photo_count: number;
	cover_id: string | null;
}>(
	`SELECT a.id::text, a.slug, a.name, a.description, a.location, a.album_date::text, a.tags,
	 COUNT(p.id)::int AS photo_count, (ARRAY_AGG(p.id::text ORDER BY p.created_at) FILTER (WHERE p.id IS NOT NULL))[1] AS cover_id
	 FROM gallery_albums a LEFT JOIN gallery_photos p ON p.album_id = a.id
	 GROUP BY a.id ORDER BY a.album_date DESC NULLS LAST, a.created_at DESC`,
);
---

<MainGridLayout title="共享相册" description="登录用户都可以创建相册、上传和管理图片。">
	<section class="card-base community-card">
		<div class="community-actions" style="justify-content:space-between"><div><h1 class="text-3xl font-bold">共享相册</h1><p class="community-muted">图片保存在腾讯云服务器，所有登录用户共同维护。</p></div>{!user && <a class="community-button primary" href="/login/?returnTo=%2Fgallery%2F">登录后管理</a>}</div>
		{notice && <p class="community-alert mt-4">{notice}</p>}{error && <p class="community-alert error mt-4">{error}</p>}
		{user && <details class="mt-5"><summary class="community-button primary inline-block cursor-pointer"><Icon is:inline name="material-symbols:add-photo-alternate-outline"/> 新建相册</summary><form method="post" class="community-form mt-4"><input type="hidden" name="action" value="create"/><label>相册名称<input name="name" maxlength="100" required/></label><label>英文地址<input name="slug" maxlength="80" pattern="[a-zA-Z0-9-]+" placeholder="summer-2026" required/></label><label>描述<input name="description" maxlength="500"/></label><div class="community-grid"><label>地点<input name="location" maxlength="120"/></label><label>日期<input name="date" type="date"/></label></div><label>标签（用英文逗号分隔）<input name="tags" maxlength="500"/></label><button class="community-button primary">创建相册</button></form></details>}
	</section>
	<section class="card-base community-card">
		{albums.rows.length ? <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">{albums.rows.map((album) => <div><AlbumCard id={album.slug} name={album.name} cover={album.cover_id ? `/api/gallery/photos/${album.cover_id}` : ""} description={album.description} date={album.album_date || undefined} location={album.location} tags={album.tags.split(",").map((tag) => tag.trim()).filter(Boolean)} photoCount={album.photo_count}/>{user && <form method="post" class="mt-2" onsubmit="return confirm('确定删除整个相册吗？')"><input type="hidden" name="action" value="delete"/><input type="hidden" name="albumId" value={album.id}/><button class="community-button">删除相册</button></form>}</div>)}</div> : <p class="community-muted">还没有相册，登录后创建第一个吧。</p>}
	</section>
</MainGridLayout>
