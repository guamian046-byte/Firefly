---
import type { CollectionEntry } from "astro:content";
import Key from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import { removeFileExtension } from "@/utils/url-utils";
import "@/styles/community.css";

interface Props {
	post?: CollectionEntry<"posts"> | CollectionEntry<"spec">;
	customPath?: string;
	title?: string;
}

const { post, customPath } = Astro.props as Props;
const slug = post ? removeFileExtension(post.id) : "index";
const path =
	customPath ||
	(post?.collection === "posts" ? `/posts/${slug}/` : `/${slug}/`);
---

<section id="post-comments" class="card-base p-6 sm:p-8 mb-6" data-native-comments data-page-path={path}>
	<div class="mb-5">
		<h3 class="text-xl font-bold">{i18n(Key.commentSection)}</h3>
		<p class="text-sm text-(--content-meta) mt-1">登录账号后即可留言，评论会立即发布。</p>
	</div>
	<div data-comment-status class="text-sm text-(--content-meta)">正在加载评论…</div>
	<div data-comment-list class="grid gap-3 my-5"></div>
	<form data-comment-form class="community-form hidden">
		<textarea name="content" maxlength="2000" required class="community-short-textarea" placeholder="写下你的评论…"></textarea>
		<div class="community-actions"><button class="community-button primary">发布评论</button><span data-comment-error class="community-muted"></span></div>
	</form>
	<p data-comment-login class="hidden text-sm">请先 <a class="community-author-link" href={`/login/?returnTo=${encodeURIComponent(Astro.url.pathname)}`}>登录</a> 后参与评论。</p>
</section>

<script>
	function initNativeComments() {
		document.querySelectorAll<HTMLElement>("[data-native-comments]").forEach((root) => {
			if (root.dataset.ready) return;
			root.dataset.ready = "true";
			const pagePath = root.dataset.pagePath || location.pathname;
			const list = root.querySelector<HTMLElement>("[data-comment-list]")!;
			const status = root.querySelector<HTMLElement>("[data-comment-status]")!;
			const form = root.querySelector<HTMLFormElement>("[data-comment-form]")!;
			const login = root.querySelector<HTMLElement>("[data-comment-login]")!;
			const error = root.querySelector<HTMLElement>("[data-comment-error]")!;
			let currentUser: { id: string; admin: boolean } | null = null;

			const escapeHtml = (value: string) => value.replace(/[&<>"']/g, (char) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[char] || char);
			async function load() {
				const response = await fetch(`/api/comments?path=${encodeURIComponent(pagePath)}`);
				const data = await response.json();
				currentUser = data.currentUser;
				form.classList.toggle("hidden", !currentUser);
				login.classList.toggle("hidden", !!currentUser);
				status.textContent = data.comments.length ? `${data.comments.length} 条评论` : "还没有评论，来留下第一条吧。";
				list.innerHTML = data.comments.map((comment: any) => `<article class="community-comment"><div><a class="community-author-link" href="/members/${encodeURIComponent(comment.username)}/">${escapeHtml(comment.display_name || comment.username)}</a><time>${new Date(comment.created_at).toLocaleString("zh-CN")}</time></div><p>${escapeHtml(comment.content).replace(/\n/g, "<br>")}</p>${currentUser && (currentUser.id === comment.author_id || currentUser.admin) ? `<button type="button" data-delete-comment="${comment.id}">删除</button>` : ""}</article>`).join("");
			}
			form.addEventListener("submit", async (event) => {
				event.preventDefault(); error.textContent = "";
				const content = String(new FormData(form).get("content") || "").trim();
				const response = await fetch("/api/comments", { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify({ path: pagePath, content }) });
				if (!response.ok) { error.textContent = await response.text(); return; }
				form.reset(); await load();
			});
			list.addEventListener("click", async (event) => {
				const button = (event.target as HTMLElement).closest<HTMLButtonElement>("[data-delete-comment]");
				if (!button || !confirm("确定删除这条评论吗？")) return;
				await fetch(`/api/comments?id=${encodeURIComponent(button.dataset.deleteComment || "")}`, { method: "DELETE" }); await load();
			});
			load().catch(() => { status.textContent = "评论暂时无法加载"; });
		});
	}
	initNativeComments();
	document.addEventListener("swup:contentReplaced", initNativeComments);
</script>
